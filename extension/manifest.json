{
  "manifest_version": 3,
  "name": "RotaOS · Ponte do Procesa",
  "version": "0.4.8",
  "description": "Coleta S025, S199, S200, S201 e S202 do Procesa para sincronização com o RotaOS, sem alterar o sistema da CESAMA.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://procesama.linedata.com.br/*"
  ],
  "action": {
    "default_title": "RotaOS · Ponte do Procesa"
  },
  "content_scripts": [
    {
      "matches": ["https://procesama.linedata.com.br/operacoes/*"],
      "js": ["procesa-network-probe.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://procesama.linedata.com.br/operacoes/*"],
      "js": ["procesa-bridge.js"],
      "css": ["procesa-bridge.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://daiened.github.io/RotaOS/*"
      ],
      "js": ["rotaos-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
